# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- ICICI Direct login (used only by scripts/get_session_token.py) ---
ICICI_USER_ID=""
ICICI_PASSWORD=""

# --- Breeze API app (https://api.icicidirect.com/apiuser/home -> your app) ---
BREEZE_API_KEY=""
BREEZE_API_SECRET=""

# --- Options expiry range (YYYY-MM-DD). Overrides expiry_start/expiry_end of
#     every [options.*] profile in config/settings.toml. Leave empty to use those.
EXPIRY_START=2025-08-01
EXPIRY_END=2025-08-10

# --- Market data downloader (scripts/download_market_data.py) ---
# Leave empty to use [market_data] in config/settings.toml (NIFTY, 1minute, 2023-09-27 -> today).
# Instrument name from [instruments.*] in settings.toml; comma-separate for several (NIFTY,BANKNIFTY)
MARKET_DATA_INSTRUMENT=NIFTY
# Optional check: must match the instrument's exchange in settings.toml (NSE for NIFTY/BANKNIFTY, BSE for SENSEX)
MARKET_DATA_EXCHANGE=NSE
# 1minute | 5minute | 30minute | 1day
MARKET_DATA_INTERVAL=1minute
MARKET_DATA_START_DATE=2023-09-27
# YYYY-MM-DD for a fixed range, or "today" to keep the dataset current on every run
MARKET_DATA_END_DATE=today
# Only for an instrument NOT in settings.toml: its Breeze stock code (plus MARKET_DATA_EXCHANGE)
# MARKET_DATA_STOCK_CODE=

# --- Optional ---
# Use a session token you obtained elsewhere instead of data/.breeze_session.json
# BREEZE_SESSION_TOKEN=""
# Lower the daily API ceiling (default 4900)
# BREEZE_DAILY_API_LIMIT=4900
# Alternative DuckDB file (relative to the repo root, or absolute)
# DUCKDB_PATH=data/market_data.duckdb

# --- Zerodha Kite Connect (zerodha/ package; see zerodha/README.md) ---
# KITE_API_KEY=""
# KITE_API_SECRET=""
# Where `python3 -m zerodha login` catches the Kite redirect. Must be EXACTLY the Redirect URL
# set for your app on developers.kite.trade. Use 127.0.0.1 (not localhost) and plain http.
# KITE_REDIRECT_URL=http://127.0.0.1:5678/kite/callback
# 1 = log orders only (default). Set 0 only when you intend to send real orders.
# KITE_DRY_RUN=1
# KITE_PRODUCT=NRML

# --- Live trading engine (live/; every key with its default is listed at the top of live/config.py) ---
# PAPER (default) = Breeze data + simulated fills. BACKTEST = DuckDB replay. LIVE is not wired yet.
TRADING_MODE=PAPER
ENABLE_LIVE_TRADING=false

# Instances: one process runs them all (python3 -m live run [--instance ID]). Ids: 1-12 letters/digits
# (the id is the Kite order tag). <ID>__KEY overrides KEY for that instance; anything not overridden falls
# back to the unprefixed KEY below and then to the default. Without INSTANCES: one instance per strategy
# in STRATEGIES (default positional,zerodte), named after the strategy.
INSTANCES=posH300,zd1

# Instance 1: positional range breakout, held to expiry, hedged with a wing 300 pts further OTM
posH300__STRATEGY=positional
posH300__POSITION_MODE=HEDGED
posH300__HEDGE_WIDTH=300
posH300__INTRADAY_ONLY=false
# posH300__EXPIRY_OFFSET=0            # 0 = nearest weekly expiry after the entry day, 1 = next week, ...
posH300__POSITIONAL_LOTS=5
posH300__RISK_MAX_DAILY_LOSS=40000
posH300__RISK_MAX_DAILY_PROFIT_ENABLED=false
posH300__RISK_MAX_DAILY_PROFIT=0

# Instance 2: 0DTE ITM straddle on expiry days, intraday, naked (as backtested)
zd1__STRATEGY=zerodte
zd1__POSITION_MODE=NAKED
zd1__INTRADAY_ONLY=true
zd1__ZERODTE_LOTS=5
zd1__RISK_MAX_DAILY_LOSS=25000
# zd1__ZERODTE_ENTRY_TIME=11:30       # override the walk-forward entry time

# Defaults shared by every instance (each can be overridden with <ID>__KEY)
# Strategy defaults: positional -> POSITION_MODE=HEDGED, HEDGE_WIDTH=300, INTRADAY_ONLY=false (hold to expiry)
#                    zerodte    -> POSITION_MODE=NAKED, INTRADAY_ONLY=true
ENTRY_START_TIME=09:15
ENTRY_END_TIME=15:00
FORCE_EXIT_TIME=15:15
# LOT_SIZE=65
# STRIKE_STEP=50
POSITIONAL_ITM_POINTS=100
POSITIONAL_SL_PCT=0.5
POSITIONAL_REENTRY=true
ZERODTE_ITM_POINTS=100
ZERODTE_SL_PCT=30
ZERODTE_REENTRY=true
# Risk (per instance). Both daily caps use the same P&L: realised + unrealised mark-to-market of that
# instance's open positions. Loss cap: blocks new entries for the day. Profit cap: squares off everything
# the instance holds (incl. overnight positions), MAX_PROFIT_REACHED, no more trades that day.
RISK_CAPITAL=1000000
RISK_MAX_RISK_PER_TRADE=60000
RISK_MAX_TRADES_PER_DAY=6
RISK_MAX_OPEN_POSITIONS=3
RISK_MAX_LOTS_PER_TRADE=5
RISK_MAX_QTY_PER_TRADE=325
RISK_MAX_REENTRIES=1
RISK_MARGIN_UTILISATION_PCT=80
RISK_MAX_DAILY_LOSS_ENABLED=true
RISK_MAX_DAILY_LOSS=50000
RISK_MAX_DAILY_PROFIT_ENABLED=false
RISK_MAX_DAILY_PROFIT=0

# Account-wide only (a prefixed value is ignored)
# SHARED_CONTRACTS=false              # may two instances hold the same contract at once?
# ACCOUNT_MAX_DAILY_LOSS=0            # 0 = off; all instances together: blocks every instance's entries
# ACCOUNT_MAX_DAILY_PROFIT=0          # 0 = off; all instances together: squares off everything
# ENGINE_POLL_SECONDS=10
# ENGINE_STOP_TIME=15:35
# ENGINE_RECONCILE_SECONDS=60
# ENGINE_RECONCILE_CONFIRMATIONS=2
# ENGINE_HALT_ON_UNKNOWN_POSITIONS=true
# ENGINE_KILL_FILE=data/live/KILL     # KILL = everything; KILL_<ID> = that instance only
# ENGINE_STATE_DIR=data/live          # data/live/<mode>/<ID>.json + _account.json + _paper_exchange.json
# PAPER_SLIPPAGE_POINTS=0.5

# ---------------------------------------------------------------------------
# Manual option trader (python3 -m trader serve): web UI on 127.0.0.1. Full table: trader/config.py
# LIVE needs ALL of: TRADER_MODE=LIVE, ENABLE_LIVE_TRADING=true, KITE_DRY_RUN=0, and `serve --live`.
# ---------------------------------------------------------------------------
TRADER_MODE=PAPER                    # PAPER (simulated exchange) | LIVE
# TRADER_PAPER_QUOTES=breeze         # breeze | manual (type prices in the UI, no Breeze session needed)
# TRADER_PORT=8765
# TRADER_PRODUCT=MIS                 # MIS | NRML (default for new trades; selectable per trade)
# TRADER_UNDERLYINGS=NIFTY,BANKNIFTY,FINNIFTY,SENSEX
# TRADER_MAX_OPEN_TRADES=3
# TRADER_MAX_TRADES_PER_DAY=10
# TRADER_MAX_LOTS_PER_TRADE=10
# TRADER_MAX_QTY_PER_TRADE=1000
# TRADER_MAX_ORDER_VALUE=500000
# TRADER_MAX_LOSS_PER_TRADE=10000
# TRADER_MAX_DAILY_LOSS=20000        # 0 = off
# TRADER_MAX_DAILY_PROFIT=0          # 0 = off
# TRADER_SQUARE_OFF_ON_DAILY_LIMIT=false
# TRADER_TRADING_START=09:15         # blank = off
# TRADER_TRADING_END=15:00           # blank = off
# TRADER_SQUARE_OFF_TIME=15:15       # mandatory for MIS
# TRADER_MAX_ENTRY_DEVIATION_PCT=20
# TRADER_BREEZE_DAILY_BUDGET=2000
